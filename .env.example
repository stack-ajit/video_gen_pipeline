# Gemini API Key (Required for scriptwriting)
GEMINI_API_KEY=your_gemini_api_key_here

# Pixabay API Key (Recommended 100% free stock video API: instant key at pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_api_key_here

# Pexels API Key (Optional: new key issuance paused by Pexels)
PEXELS_API_KEY=your_pexels_api_key_here

# Social Media Publishing (Phase 6 / 7)
# YouTube OAuth2 client secret file path:
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

# Instagram (Optional):
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
